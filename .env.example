# Sentinel Extension Environment Configuration
APP_NAME="Sentinel Extension Detector"
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Security Limits
MAX_UPLOAD_SIZE_BYTES=26214400      # 25 MB
MAX_EXPANDED_SIZE_BYTES=52428800    # 50 MB
MAX_FILE_COUNT=500
MAX_NESTING_DEPTH=3
MAX_SCRIPT_SIZE_BYTES=5242880       # 5 MB per script

# Storage
DATABASE_URL=sqlite:///sentinel.db
